<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZeroBrowser.App.ViewModels"
        x:Class="ZeroBrowser.App.Views.AutomationRunnerWindow"
        x:DataType="vm:AutomationRunnerViewModel"
        Width="780" Height="600"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.png"
        Title="Automation runner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0" Text="Automation runner — Playwright / Puppeteer scripts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="Run a Node.js script that attaches to the active browser session via CDP. The script receives the browser's WebSocket URL as $env:CDP_WS_URL."
               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="Node.js script (.js / .mjs)" FontSize="12" Margin="0,0,0,4"/>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding ScriptPath, Mode=TwoWay}" FontFamily="Consolas,Menlo,monospace"/>
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseScriptCommand}"/>
      </Grid>

      <Border Grid.Row="2" BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
          <TextBlock Text="{Binding Output}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
        <Button Content="Run"   Command="{Binding RunCommand}"    IsDefault="True"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}"/>
        <Button Content="Clear" Command="{Binding ClearCommand}"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="11" Opacity="0.7" Margin="0,12,0,0"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" Click="OnCloseClick"/>
    </StackPanel>
  </Grid>
</Window>
